# ── Server ──
PORT=8000
ENVIRONMENT=development

# ── Database ──
DATABASE_URL=postgres://postgres:postgres@localhost:5432/lucosms?sslmode=disable

# ── Resend Email Provider ──
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=Beta <beta@info.pitbox.fun>

# ── Auth ──
JWT_SECRET=change-this-to-a-secure-random-string

# ── Redis (optional; app falls back to Postgres if unavailable) ──
REDIS_ADDR=
REDIS_USERNAME=default
REDIS_PASSWORD=
REDIS_DB=0

# ── Public backend URL used for emails, uploads, and payment callbacks ──
PUBLIC_URL=https://api.example.com
# PUBLIC_BASE_URL is also supported for backward compatibility.
# Use http:// for localhost (https://localhost links in emails will not open).

# ── Web app origin: verification emails link to its /verify-email page ──
# Leave empty to link straight to the backend's HTML verify page instead.
FRONTEND_URL=http://localhost:5173

# ── Verification / password-reset SMS codes are billed to the user ──
AUTH_SMS_FEE_UGX=35
AUTH_SMS_FEE_CREDITS=1

# ── MarzPay ──
MARZPAY_BASE_URL=https://wallet.wearemarz.com/api/v1
# Accepts either the base64 token or username:password; the backend sends Basic auth.
MARZPAY_BASIC_AUTH=

# ── WhatsApp (whatsmeow linked-device sessions) ──
# Sessions live inside this process: run exactly ONE instance with this enabled (not serverless).
WHATSAPP_ENABLED=true
# Random pause between messages from the same number
WHATSAPP_MIN_DELAY_SECONDS=4
WHATSAPP_MAX_DELAY_SECONDS=12
# Messages per number per day; newly linked numbers use the warm-up limit
WHATSAPP_DAILY_LIMIT=250
WHATSAPP_WARMUP_DAILY_LIMIT=40
WHATSAPP_WARMUP_DAYS=7
WHATSAPP_MAX_RECIPIENTS=200
WHATSAPP_MAX_ACCOUNTS_PER_USER=3

# ── AI template generation (NVIDIA NIM) ──
# Server-side only; never expose this key to the frontend.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Comma-separated chat models, in fallback order. The app switches automatically when one is overloaded,
# times out or is retired, and remembers failures (busy models cool down; retired ones are skipped for 6h).
# Users can also pick one in the chat; the rest stay as fallbacks. Retired so far: mistralai/mistral-nemotron (410).
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b,nvidia/nemotron-3-ultra-550b-a55b,nvidia/nemotron-3.5-lightning-30b-a3b,deepseek-ai/deepseek-v4.1-flash,moonshotai/kimi-k3,z-ai/glm-5.3-flash,openai/gpt-oss-20b
# Image generation for the AI assistant (uses the same NVIDIA_API_KEY). Comma-separated, in fallback order.
NVIDIA_IMAGE_BASE_URL=https://ai.api.nvidia.com/v1/genai
NVIDIA_IMAGE_MODEL=black-forest-labs/flux.2-klein-4b,black-forest-labs/flux.1-schnell,black-forest-labs/flux.1-dev
# Stock photos shown before AI images (https://www.pexels.com/api/). PEXEL_API_KEY is also accepted.
PEXELS_API_KEY=
